# Required — get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional — defaults shown
GROQ_MODEL=llama-3.3-70b-versatile
WHISPER_MODEL=whisper-large-v3
APP_ENV=development

# Optional — falls back to a local SQLite file when unset.
# In production set this to the managed Postgres connection string.
# DATABASE_URL=postgresql://user:password@host:5432/vaidyaai

# Comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
